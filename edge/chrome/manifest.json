{
  "manifest_version": 3,
  "name": "viki reader",
  "version": "0.1.0",
  "description": "Reads your own notifications into your local viki. Observe only - it never posts, replies, or clicks.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.facebook.com/*",
    "https://discord.com/*",
    "https://d2l.coloradomesa.edu/*",
    "https://mavnet.coloradomesa.edu/cmu_redir/*",
    "https://outlook.cloud.microsoft/*",
    "https://outlook.office.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "viki reader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "content/common.js",
        "sites/facebook.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://discord.com/*"
      ],
      "js": [
        "content/common.js",
        "sites/discord.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://d2l.coloradomesa.edu/*",
        "https://mavnet.coloradomesa.edu/cmu_redir/*"
      ],
      "js": [
        "content/common.js",
        "sites/d2l.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.cloud.microsoft/*",
        "https://outlook.office.com/*"
      ],
      "js": [
        "content/common.js",
        "sites/outlook.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
