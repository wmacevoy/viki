# Pinned versions for viki's rung-2 (ONNX embedding) build inputs.
#
# Both onnxruntime and the model are distributed as downloaded, pinned,
# SHA256-verified release artifacts -- same pattern build/build.sh's
# fossil-see uses for LibreSSL (a source tarball, in that case). Neither
# is a git submodule: onnxruntime's prebuilt releases don't ship source in
# a form worth vendoring as a submodule (building it from source is a
# multi-hour, heavy-toolchain undertaking, out of proportion to what's
# needed here), and the model is fundamentally a binary weights blob, not
# source. Cached locally after first download, same as LibreSSL's tarball
# cache; a real deployment gets these via `fossil uv pull` from the hub
# after the first peer bootstraps them (see viki-manifest, ENCRYPTION.md-
# style "no runtime third-party downloads" ethos, D-12) -- this script's
# direct-download path is the bootstrap step, not the steady state.

# -- ONNX Runtime (dynamic library; no static build offered upstream) --
# Source: github.com/microsoft/onnxruntime releases. C API only (no C++
# wrapper used), so the exact build flavor (CPU vs CPU+CoreML etc.)
# doesn't matter much -- picked the plain CPU release per platform.
ONNXRUNTIME_VERSION=1.29.0
ONNXRUNTIME_OSX_ARM64_URL=https://github.com/microsoft/onnxruntime/releases/download/v1.29.0/onnxruntime-osx-arm64-1.29.0.tgz
ONNXRUNTIME_OSX_ARM64_SHA256=d0706fc34f315d8c88639d0a8c81f2e09e815f282cabed3493c06a054352cf92
ONNXRUNTIME_LINUX_X64_URL=https://github.com/microsoft/onnxruntime/releases/download/v1.29.0/onnxruntime-linux-x64-1.29.0.tgz
ONNXRUNTIME_LINUX_X64_SHA256=c3fddc4f139a045b0c4902c57410f0694f1c2fdf9b6939fbe38b1aeae7cd14ba
ONNXRUNTIME_LINUX_ARM64_URL=https://github.com/microsoft/onnxruntime/releases/download/v1.29.0/onnxruntime-linux-aarch64-1.29.0.tgz
ONNXRUNTIME_LINUX_ARM64_SHA256=e1799098ebc054b370f6176a450f158720f297818c613e5dc99b92e2ec82346f

# -- Embedding model: sentence-transformers/all-MiniLM-L6-v2, ARM64-recipe --
# INT8 dynamic quantization (~23MB, matches VIKI_DESIGN.md's rung-2 budget).
# 384-dim output (config.json hidden_size=384), BERT/WordPiece tokenization.
#
# Picked the arm64-quantization-recipe export (not avx512/avx2) because
# this project's dev/test machine is Apple Silicon and could be verified
# empirically here; optimum's quantization presets (arm64 vs avx512 vs
# avx2) differ in calibration granularity, not in which CPU can execute
# the resulting graph -- ONNX Runtime's INT8 ops are portable -- but this
# has NOT been empirically verified on x86 yet. See FINDINGS.md: revisit
# before relying on this on an x86 device; the "one universal pinned
# model" design (D-11) is in some tension with per-arch-optimized
# quantized exports upstream offers, and picking one file glosses over
# that tension rather than resolving it.
VIKI_MODEL_ID=all-MiniLM-L6-v2-qint8-arm64
VIKI_MODEL_DIM=384
VIKI_MODEL_URL=https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/resolve/main/onnx/model_qint8_arm64.onnx
VIKI_MODEL_SHA256=4278337fd0ff3c68bfb6291042cad8ab363e1d9fbc43dcb499fe91c871902474
VIKI_VOCAB_URL=https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/resolve/main/vocab.txt
VIKI_VOCAB_SHA256=07eced375cec144d27c900241f3e339478dec958f92fddbc551f295c992038a3
